<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Block access to all hidden files and folders (.env, .git, etc.)
    RewriteRule (^|/)\.(?!well-known) - [F,L]

    # 2. Block direct access to internal sensitive Laravel core directories (exclude public storage)
    RewriteRule ^(app|bootstrap|config|database|resources|routes|tests|vendor|docs)/ - [F,L]

    # 3. Block access to sensitive storage subdirectories
    RewriteRule ^storage/(framework|logs)/ - [F,L]

    # 4. Block access to sensitive root configuration files
    RewriteRule ^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.js|tailwind\.config\.js)$ - [F,L]

    # 5. Route public storage requests to public/storage/
    RewriteRule ^storage/(.*)$ public/storage/$1 [L]

    # 6. Route all other requests to public/ folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

