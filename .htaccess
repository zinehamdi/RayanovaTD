<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Block access to all hidden files and folders (.env, .git, etc.)
    RewriteRule (^|/)\.(?!well-known) - [F,L]

    # 2. Block direct access to sensitive Laravel core directories
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor|docs)/ - [F,L]

    # 3. Block access to sensitive root configuration files
    RewriteRule ^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.js|tailwind\.config\.js)$ - [F,L]

    # 4. Route all requests to public/ folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
