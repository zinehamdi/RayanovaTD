# ==============================================================================
# ⚓ RAYANOVA T.D — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (HOSTINGER)
# ==============================================================================
# Instructions:
# 1. Duplicate this file on the server as .env:
#    cp .env.production.example .env
# 2. Fill in your MySQL database credentials created in Hostinger hPanel.
# 3. Generate the application key:
#    php artisan key:generate
# 4. Run database migrations with seeds:
#    php artisan migrate --seed --force
# ==============================================================================

APP_NAME="Rayanova T.D"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://rayanovatd.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logging Configuration
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# 🗄️ Database Configuration (Hostinger MySQL / MariaDB)
# ------------------------------------------------------------------------------
# In Hostinger hPanel -> Databases -> Management:
# Create a new database and user. Hostinger prefixes database names
# with your account ID (u346640129_...).
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u346640129_rayanova
DB_USERNAME=u346640129_admin
DB_PASSWORD="YOUR_SECURE_DB_PASSWORD"

# ------------------------------------------------------------------------------
# ⚡ Cache, Sessions & Queue Drivers
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=rayanova_cache

# ------------------------------------------------------------------------------
# 📧 Mail Configuration (Hostinger Business Email / Titan Mail)
# ------------------------------------------------------------------------------
# In Hostinger Emails -> Email Accounts:
# Default SMTP settings:
# Host: smtp.hostinger.com (or smtp.titan.email)
# Port: 465 (SSL) or 587 (TLS)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=contact@rayanovatd.com
MAIL_PASSWORD="YOUR_EMAIL_PASSWORD"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="contact@rayanovatd.com"
MAIL_FROM_NAME="Rayanova T.D"

# Notification recipients for incoming B2B RFQs
RFQ_NOTIFY_EMAIL="sales@rayanovatd.com"

# ------------------------------------------------------------------------------
# 📱 Livewire & Asset HTTPS Enforcement
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
